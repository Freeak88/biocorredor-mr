# Fungimap Cloud Functions — Environment Variables
# Copy to .env and fill with real values before deploying

# Gemini API Key (server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin email for notifications (optional)
ADMIN_EMAIL=DamianFerraro@gmail.com

# Storage bucket (auto-configured by Firebase CLI, but can be overridden)
# STORAGE_BUCKET=gen-lang-client-0071700294.firebasestorage.app
