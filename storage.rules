// =============================================================================
// Fungimap — Storage Security Rules
// =============================================================================
// Deploy: firebase deploy --only storage:rules
// =============================================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- Authenticated users can upload sighting images ---
    match /sightings/{userId}/{imageId} {
      allow read: if true; // Public read for sighting images
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Thumbnails (public read, written by Cloud Functions) ---
    match /thumbnails/{imageId} {
      allow read: if true;
      allow write: if false; // Cloud Functions via admin SDK
    }

    // --- Exports (signed URLs, no direct access) ---
    match /exports/{userId}/{exportFile} {
      allow read, write: if false; // Access via signed URLs only
    }
  }
}
