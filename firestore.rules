// =============================================================================
// Fungimap — Firestore Security Rules
// =============================================================================
// Deploy: firebase deploy --only firestore:rules
// =============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'DamianFerraro@gmail.com';
    }

    // --- Users ---
    match /users/{userId} {
      // Any authenticated user can read profiles
      allow read: if isAuthenticated();
      // Users can write their own profile
      allow write: if isOwner(userId);
    }

    // --- Sightings ---
    match /sightings/{sightingId} {
      // Anyone authenticated can read sightings
      allow read: if isAuthenticated();
      // Any authenticated user can create (Cloud Function is the preferred path)
      allow create: if isAuthenticated();
      // Only the owner or admin can update/delete
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // --- Sighting Comments (subcollection) ---
    match /sightings/{sightingId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // --- Chat Messages ---
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // --- Logs ---
    match /logs/{logId} {
      // Only admin can read logs directly; Cloud Functions write via admin SDK (bypass rules)
      allow read: if isAdmin();
      allow write: if false; // Written by Cloud Functions only
    }

    // --- Reports ---
    match /reports/{reportId} {
      // Anyone authenticated can create a report
      allow create: if isAuthenticated();
      // Only admin can read/update reports
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Rate Limits (internal, written by Cloud Functions) ---
    match /rate_limits/{userId}/{action}/{reqId} {
      allow read, write: if false; // Admin SDK only
    }

    // --- Exports (temp files metadata, managed by Cloud Functions) ---
    match /exports/{exportId} {
      allow read, write: if false; // Admin SDK only
    }
  }
}
